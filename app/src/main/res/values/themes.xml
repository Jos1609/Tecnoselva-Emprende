<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TecnoSelvaFactura" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_navy</item>
        <item name="colorPrimaryVariant">@color/brand_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorSecondaryVariant">@color/brand_green_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/brand_card</item>
        <item name="colorOnSurface">@color/brand_text_primary</item>
        <item name="colorError">@color/brand_danger</item>
        <item name="colorControlHighlight">@color/brand_blue_soft</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_card</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="android:textColorPrimary">@color/brand_text_primary</item>
        <item name="android:textColorSecondary">@color/brand_text_secondary</item>
        <item name="textAppearanceBody1">@style/TextAppearance.TecnoSelva.Body</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.TecnoSelva.Title</item>
        <item name="materialButtonStyle">@style/Widget.TecnoSelva.Button</item>
        <item name="textInputStyle">@style/Widget.TecnoSelva.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.TecnoSelva.BottomNavigation</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
    </style>

    <style name="Theme.TecnoSelvaFactura.NoActionBar" parent="Theme.TecnoSelvaFactura">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TecnoSelvaFactura.FullScreen" parent="Theme.TecnoSelvaFactura.NoActionBar" />

    <style name="Theme.TecnoSelvaFactura.Splash" parent="Theme.TecnoSelvaFactura.FullScreen">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="TextAppearance.TecnoSelva.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.TecnoSelva.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TecnoSelva.Eyebrow" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.TecnoSelva.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_navy</item>
        <item name="rippleColor">@color/brand_blue_soft</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.TecnoSelva.Button.Primary" parent="Widget.TecnoSelva.Button">
        <item name="backgroundTint">@color/brand_green</item>
    </style>

    <style name="Widget.TecnoSelva.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_navy</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/brand_border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/brand_card</item>
    </style>

    <style name="Widget.TecnoSelva.Button.Compact" parent="Widget.TecnoSelva.Button.Outlined">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.TecnoSelva.Button.Filter" parent="Widget.TecnoSelva.Button.Compact">
        <item name="android:textColor">@color/selector_filter_text</item>
        <item name="backgroundTint">@color/selector_filter_background</item>
        <item name="strokeColor">@color/brand_border_strong</item>
    </style>

    <style name="Widget.TecnoSelva.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/brand_card</item>
        <item name="boxStrokeColor">@color/brand_navy</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/brand_text_secondary</item>
        <item name="android:textColorHint">@color/brand_text_secondary</item>
    </style>

    <style name="Widget.TecnoSelva.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@color/brand_card</item>
        <item name="itemIconTint">@color/selector_bottom_navigation</item>
        <item name="itemTextColor">@color/selector_bottom_navigation</item>
        <item name="itemRippleColor">@color/brand_blue_soft</item>
        <item name="elevation">10dp</item>
    </style>

    <style name="Theme.TecnoSelvaFactura.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="Theme.TecnoSelvaFactura.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <style name="ThemeOverlay.TecnoSelva.CatalogDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="backgroundInsetStart">0dp</item>
        <item name="backgroundInsetEnd">0dp</item>
        <item name="backgroundInsetTop">0dp</item>
        <item name="backgroundInsetBottom">0dp</item>
    </style>
</resources>
