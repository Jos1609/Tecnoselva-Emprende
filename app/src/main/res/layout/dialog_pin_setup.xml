<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pin_setup_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:id="@+id/tvPinDialogStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="CONFIGURACIÓN SEGURA  ·  1 DE 2"
        android:textColor="@color/brand_green_dark"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

    <TextView
        android:id="@+id/tvPinDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Crea tu PIN"
        android:textColor="@color/brand_text_primary"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPinDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="Elige seis dígitos para proteger el acceso a tu negocio."
        android:textColor="@color/brand_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/pinDots"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center"
        android:textColor="@color/brand_danger"
        android:textSize="12sp"
        android:visibility="invisible" />

    <GridLayout
        android:id="@+id/pinKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelPin"
        style="@style/Widget.TecnoSelva.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Cancelar" />
</LinearLayout>
