<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/brand_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_border"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_status_chip"
                android:backgroundTint="@color/brand_blue_soft"
                android:padding="9dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Comprobante"
                    android:src="@drawable/ic_document"
                    app:tint="@color/brand_navy" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvInvoiceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="FACTURA · F001-001"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvInvoiceDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="02/11/2026 · 10:30"
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvInvoiceTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="S/ 50.00"
                android:textColor="@color/brand_navy"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="13dp"
            android:background="@color/brand_border" />
        <TextView
            android:id="@+id/tvClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Cliente · 20123456789"
            android:textColor="@color/brand_text_primary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvInvoiceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Subtotal S/ 0.00  ·  IGV S/ 0.00"
            android:textColor="@color/brand_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvInvoiceError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_chip"
            android:backgroundTint="@color/brand_danger_soft"
            android:padding="10dp"
            android:textColor="@color/brand_danger"
            android:textSize="12sp"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvInvoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:text="PENDIENTE"
                android:textSize="10sp"
                android:textStyle="bold" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareInvoice"
                style="@style/Widget.TecnoSelva.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="Compartir"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/brand_navy" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
