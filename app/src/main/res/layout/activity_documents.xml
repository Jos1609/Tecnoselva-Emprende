<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Buscar por número, cliente o documento"
            app:startIconDrawable="@drawable/ic_search">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInvoiceSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewDocument"
            style="@style/Widget.TecnoSelva.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:text="Nuevo comprobante"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <TextView
            android:id="@+id/tvInvoiceCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Consulta, previsualiza y comparte tus comprobantes"
            android:textColor="@color/brand_text_secondary"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupDocumentFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterAll"
                    style="@style/Widget.TecnoSelva.Button.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Todos" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterInvoices"
                    style="@style/Widget.TecnoSelva.Button.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Facturas" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterReceipts"
                    style="@style/Widget.TecnoSelva.Button.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Boletas" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterNotes"
                    style="@style/Widget.TecnoSelva.Button.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Notas" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/progressInvoices"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_green"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvInvoicesMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:gravity="center"
            android:padding="18dp"
            android:textColor="@color/brand_text_secondary"
            android:visibility="gone" />
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshInvoices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInvoices"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="14dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationDocuments"
        style="@style/Widget.TecnoSelva.BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation" />
</LinearLayout>
