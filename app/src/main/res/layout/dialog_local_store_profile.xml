<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configura tu emprendimiento para empezar a vender."
            android:textColor="@color/brand_text_secondary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ivLocalStoreLogo"
            android:layout_width="120dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:contentDescription="Logo del emprendimiento"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_store" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectLocalStoreLogo"
            style="@style/Widget.TecnoSelva.Button.Compact"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Agregar logo opcional"
            app:icon="@drawable/ic_gallery_black_24dp"
            app:iconTint="@color/brand_navy" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLocalBusinessName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nombre del negocio *">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocalBusinessName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLocalAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Dirección">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocalAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLocalPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Número de celular">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocalPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkLocalTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Acepto los términos y condiciones"
            android:textColor="@color/brand_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En el modo local, tus datos se guardan en este dispositivo. TECNOSELVA EMPRENDE no garantiza la recuperación si el equipo se pierde, se daña o se desinstala la app. Te recomendamos exportar respaldos periódicamente."
            android:textColor="@color/brand_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
