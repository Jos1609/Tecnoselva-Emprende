<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/brand_background" android:orientation="vertical">
    <LinearLayout android:id="@+id/catalogContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Buscar producto, servicio o SKU" app:startIconDrawable="@drawable/ic_search">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPosSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/groupPosFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/posFilterAll" style="@style/Widget.TecnoSelva.Button.Filter" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Todo" />
            <com.google.android.material.button.MaterialButton android:id="@+id/posFilterProducts" style="@style/Widget.TecnoSelva.Button.Filter" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Productos" />
            <com.google.android.material.button.MaterialButton android:id="@+id/posFilterServices" style="@style/Widget.TecnoSelva.Button.Filter" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Servicios" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <ProgressBar android:id="@+id/progressPos" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:indeterminateTint="@color/brand_green" android:visibility="gone" />
        <TextView android:id="@+id/tvPosMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="20dp" android:textColor="@color/brand_text_secondary" android:visibility="gone" />
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefreshPos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPosCatalog" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="10dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/checkoutContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/TextAppearance.TecnoSelva.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VENTA ACTUAL" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginBottom="12dp" android:text="Detalle y cobro" android:textColor="@color/brand_text_primary" android:textSize="22sp" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPosCart" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Comprobante y cliente" android:textColor="@color/brand_text_primary" android:textSize="17sp" android:textStyle="bold" />
                    <Spinner android:id="@+id/spinnerPosDocumentType" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_spinner" />
                    <Spinner android:id="@+id/spinnerPosCustomerDocType" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_spinner" />
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Número de documento">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPosCustomerDocument" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Nombre o razón social">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPosCustomerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchPosIgv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:paddingVertical="6dp" android:text="Precio afecto a IGV (18%)" android:textColor="@color/brand_text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Forma de pago" android:textColor="@color/brand_text_primary" android:textSize="17sp" android:textStyle="bold" />
                    <Spinner android:id="@+id/spinnerPosPaymentMode" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_spinner" />
                    <Spinner android:id="@+id/spinnerPosPaymentMethod" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_spinner" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutPosAmountPaid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Monto recibido" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPosAmountPaid" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/brand_navy" app:cardCornerRadius="18dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/tvPosSubtotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CFFFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/tvPosTax" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#CFFFFFFF" android:textSize="14sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="#35FFFFFF" />
                    <TextView android:id="@+id/tvPosCheckoutTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FF8DE8CA" android:textSize="23sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCompletePosSale" style="@style/Widget.TecnoSelva.Button.Primary" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="14dp" android:text="Registrar y cobrar" app:icon="@drawable/ic_cart" app:iconTint="@color/white" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBackToPosCatalog" style="@style/Widget.TecnoSelva.Button.Outlined" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:text="Seguir agregando" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/cartBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="8dp" app:cardBackgroundColor="@color/brand_navy" app:cardCornerRadius="17dp" app:cardElevation="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvPosCartSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Carrito vacío" android:textColor="#CFFFFFFF" android:textSize="12sp" />
                <TextView android:id="@+id/tvPosCartTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="S/ 0.00" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenPosCart" style="@style/Widget.TecnoSelva.Button.Primary" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Cobrar" app:icon="@drawable/ic_cart" app:iconTint="@color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigationPos" style="@style/Widget.TecnoSelva.BottomNavigation" android:layout_width="match_parent" android:layout_height="68dp" app:labelVisibilityMode="labeled" app:menu="@menu/bottom_navigation" />
</LinearLayout>
