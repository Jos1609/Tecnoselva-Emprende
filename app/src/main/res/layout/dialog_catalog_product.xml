<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/brand_surface_subtle"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/ivCatalogProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:contentDescription="Imagen del producto"
                    android:padding="28dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_store" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCatalogImageCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:clipToPadding="false"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/imageActionsCatalog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/brand_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="8dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectCatalogImage"
                        style="@style/Widget.TecnoSelva.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="Seleccionar foto"
                        app:icon="@drawable/ic_gallery_black_24dp"
                        app:iconTint="@color/brand_navy" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemoveCatalogImage"
                        style="@style/Widget.TecnoSelva.Button.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Quitar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/brand_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información básica"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Identifica el producto para encontrarlo rápidamente."
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="12sp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCatalogName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Nombre del producto *">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCatalogName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Código automático"
                        app:helperText="Se genera al guardar">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCatalogSku"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="Categoría"
                        app:endIconMode="dropdown_menu"
                        app:helperText="Elige o escribe una nueva">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/etCatalogCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/brand_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchCatalogVariants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="El producto tiene variantes"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ejemplos: talla, color, presentación o capacidad."
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="12sp" />
                <LinearLayout
                    android:id="@+id/sectionCatalogVariants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/containerCatalogVariants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddCatalogVariant"
                        style="@style/Widget.TecnoSelva.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Agregar variante"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/brand_navy" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCatalogBasePricing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/brand_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precios e inventario"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="El precio mínimo evita vender por debajo del límite permitido."
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="12sp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCatalogPurchasePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Precio de compra *"
                    app:helperText="Costo pagado al proveedor"
                    app:prefixText="S/ ">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCatalogPurchasePrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCatalogSalePrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Venta *"
                        app:prefixText="S/ ">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCatalogSalePrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCatalogMinimumPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="Mínimo *"
                        app:prefixText="S/ ">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCatalogMinimumPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCatalogStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Stock inicial"
                    app:helperText="Si usas variantes, se sumará el stock de cada una">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCatalogStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCatalogWholesale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="@color/brand_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/brand_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precios por mayor"
                    android:textColor="@color/brand_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Agrega escalas por cantidad. El precio debe ser mayor al costo de compra."
                    android:textColor="@color/brand_text_secondary"
                    android:textSize="12sp" />
                <LinearLayout
                    android:id="@+id/containerCatalogWholesale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCatalogWholesale"
                    style="@style/Widget.TecnoSelva.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Agregar escala mayorista"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/brand_navy" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
