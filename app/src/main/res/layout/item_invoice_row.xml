<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="16dp" app:cardElevation="0dp"
    app:strokeColor="@color/brand_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvRowDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/brand_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvRowMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/brand_text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/tvRowTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/brand_navy" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnEditRow" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_status_chip" android:contentDescription="Editar ítem" android:padding="10dp" android:src="@android:drawable/ic_menu_edit" app:tint="@color/brand_navy" />
        <ImageButton android:id="@+id/btnDeleteRow" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:background="@drawable/bg_status_chip" android:backgroundTint="@color/brand_danger_soft" android:contentDescription="Eliminar ítem" android:padding="10dp" android:src="@android:drawable/ic_menu_delete" app:tint="@color/brand_danger" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
