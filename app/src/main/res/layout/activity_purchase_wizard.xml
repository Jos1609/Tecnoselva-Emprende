<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/brand_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/brand_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingTop="13dp" android:paddingEnd="18dp" android:paddingBottom="13dp">
        <TextView android:id="@+id/stepSupplierIndicator" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_status_chip" android:backgroundTint="@color/brand_navy" android:gravity="center" android:text="1" android:textColor="@color/white" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:text="Proveedor" android:textColor="@color/brand_text_primary" android:textSize="12sp" android:textStyle="bold" />
        <View android:layout_width="18dp" android:layout_height="1dp" android:background="@color/brand_border_strong" />
        <TextView android:id="@+id/stepProductsIndicator" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/bg_status_chip" android:backgroundTint="@color/brand_surface_subtle" android:gravity="center" android:text="2" android:textColor="@color/brand_text_secondary" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:text="Productos" android:textColor="@color/brand_text_secondary" android:textSize="12sp" android:textStyle="bold" />
        <View android:layout_width="18dp" android:layout_height="1dp" android:background="@color/brand_border_strong" />
        <TextView android:id="@+id/stepReviewIndicator" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/bg_status_chip" android:backgroundTint="@color/brand_surface_subtle" android:gravity="center" android:text="3" android:textColor="@color/brand_text_secondary" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="Revisar" android:textColor="@color/brand_text_secondary" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/brand_border" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/panelSupplier" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView style="@style/TextAppearance.TecnoSelva.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PASO 1 DE 3" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="¿De quién compraste?" android:textColor="@color/brand_text_primary" android:textSize="23sp" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Datos del proveedor" android:textColor="@color/brand_text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre del proveedor *"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPurchaseSupplier" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="RUC (opcional)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPurchaseRuc" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="11" /></com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Documento y condiciones" android:textColor="@color/brand_text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="N° de factura o boleta"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPurchaseInvoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Fecha de compra"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPurchaseDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Descuento del proveedor"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPurchaseDiscount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" /></com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/panelProducts" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView style="@style/TextAppearance.TecnoSelva.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PASO 2 DE 3" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="¿Qué compraste?" android:textColor="@color/brand_text_primary" android:textSize="23sp" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Agregar producto" android:textColor="@color/brand_text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAddPurchaseItem" style="@style/Widget.TecnoSelva.Button.Outlined" android:layout_width="match_parent" android:layout_height="50dp" android:text="Agregar producto" app:icon="@drawable/ic_add" app:iconTint="@color/brand_navy" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/tvPurchaseItemsCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="6dp" android:text="0 ítems agregados" android:textColor="@color/brand_text_primary" android:textSize="13sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/purchaseItemsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/tvPurchaseWizardTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/brand_navy" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/panelReview" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView style="@style/TextAppearance.TecnoSelva.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PASO 3 DE 3" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Revisa tu compra" android:textColor="@color/brand_text_primary" android:textSize="23sp" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_border" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:id="@+id/tvPurchaseReviewSupplier" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brand_text_primary" android:textSize="18sp" android:textStyle="bold" /><TextView android:id="@+id/tvPurchaseReviewDocument" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/brand_text_secondary" android:textSize="13sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/brand_border" app:strokeWidth="1dp"><LinearLayout android:id="@+id/purchaseReviewItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" /></com.google.android.material.card.MaterialCardView>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Notas (opcional)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPurchaseNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" android:gravity="top" /></com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/tvPurchaseReviewTotals" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/brand_navy" android:textSize="17sp" android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/brand_card" android:elevation="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="11dp" android:paddingEnd="16dp" android:paddingBottom="11dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPurchasePrevious" style="@style/Widget.TecnoSelva.Button.Outlined" android:layout_width="wrap_content" android:layout_height="52dp" android:text="Atrás" android:visibility="invisible" />
        <LinearLayout android:id="@+id/purchaseBottomTotal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOTAL" android:textColor="@color/brand_text_secondary" android:textSize="10sp" android:textStyle="bold" /><TextView android:id="@+id/tvPurchaseBottomTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S/ 0.00" android:textColor="@color/brand_green_dark" android:textSize="17sp" android:textStyle="bold" /></LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPurchaseNext" style="@style/Widget.TecnoSelva.Button.Primary" android:layout_width="wrap_content" android:layout_height="52dp" android:text="Continuar" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPurchaseSave" style="@style/Widget.TecnoSelva.Button.Primary" android:layout_width="wrap_content" android:layout_height="54dp" android:text="Registrar compra" android:visibility="gone" app:icon="@drawable/ic_cart" app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
