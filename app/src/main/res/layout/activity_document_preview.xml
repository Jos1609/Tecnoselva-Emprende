<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/previewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPreview"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/brand_navy"
        app:navigationContentDescription="Volver a facturación"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitle="Vista previa A4"
        app:subtitleTextColor="#BFFFFFFF"
        app:title="Comprobante"
        app:titleTextColor="@color/white" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePreview"
        style="@style/Widget.TecnoSelva.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="Compartir PDF"
        app:icon="@drawable/ic_share"
        app:iconGravity="textStart"
        app:iconTint="@color/brand_navy" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/scrollPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">
            <LinearLayout
                android:id="@+id/previewPages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical" />
        </ScrollView>
        <ProgressBar
            android:id="@+id/progressPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_green" />
        <TextView
            android:id="@+id/tvPreviewError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_status_chip"
            android:backgroundTint="@color/brand_danger_soft"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="@color/brand_danger"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
