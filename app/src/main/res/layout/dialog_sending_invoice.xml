<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="30dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <ProgressBar
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/brand_green" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Enviando comprobante"
        android:textColor="@color/brand_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="Espera mientras SUNAT procesa y responde la solicitud."
        android:textColor="@color/brand_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
