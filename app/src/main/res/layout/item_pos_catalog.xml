<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/brand_card" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/brand_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <ImageView android:id="@+id/ivCatalogType" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_status_chip" android:backgroundTint="@color/brand_blue_soft" android:contentDescription="Tipo" android:padding="11dp" android:src="@drawable/ic_store" app:tint="@color/brand_navy" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvCatalogName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/brand_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvCatalogMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/brand_text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/tvCatalogStock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/brand_success" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/tvCatalogPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_navy" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="end" android:layout_marginTop="7dp" android:background="@drawable/bg_status_chip" android:backgroundTint="@color/brand_green" android:gravity="center" android:text="+" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
