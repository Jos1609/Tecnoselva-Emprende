<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background">

    <LinearLayout
        android:id="@+id/localCatalogContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="68dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buscar por nombre, SKU, categoría o variante"
                    app:startIconDrawable="@drawable/ic_search">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLocalCatalogSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingEnd="104dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <ImageButton
                    android:id="@+id/btnCatalogCategoryFilter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Filtrar por categoría"
                    android:padding="12dp"
                    android:src="@drawable/ic_filter_list"
                    app:tint="@color/brand_text_secondary" />
                <ImageButton
                    android:id="@+id/btnOpenPurchases"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="54dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Abrir compras"
                    android:padding="12dp"
                    android:src="@drawable/ic_cart"
                    app:tint="@color/brand_navy" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLocalCatalogCount"
                style="@style/TextAppearance.TecnoSelva.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="0 productos" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLocalCatalog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="88dp" />

                <LinearLayout
                    android:id="@+id/emptyLocalCatalog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Catálogo vacío"
                        android:src="@drawable/ic_store"
                        app:tint="@color/brand_text_muted" />

                    <TextView
                        android:id="@+id/tvEmptyLocalCatalog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:textColor="@color/brand_text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExportCatalogPdf"
        style="@style/Widget.TecnoSelva.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="144dp"
        android:text="PDF"
        app:icon="@drawable/ic_share"
        app:iconTint="@color/brand_navy" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddLocalProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="88dp"
        android:contentDescription="Agregar producto"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/brand_green"
        app:tint="@color/white" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationLocalCatalog"
        style="@style/Widget.TecnoSelva.BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
